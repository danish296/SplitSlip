# ──────────────────────────────────────────────────────────────
# SplitSlip — environment template
#
# Copy to `.env.local` and fill in your own values:
#   cp .env.example .env.local
#
# `npx convex dev` writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL for you
# the first time you run it, so you normally only edit the optional keys.
# ──────────────────────────────────────────────────────────────

# ── Client (Vite) ────────────────────────────────────────────
# Your Convex deployment URL. Printed by `npx convex dev`.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex HTTP actions endpoint — same subdomain, `.site` suffix.
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site


# ── Convex CLI ───────────────────────────────────────────────
# Which deployment `npx convex dev` and `npx convex deploy` target.
CONVEX_DEPLOYMENT=dev:your-deployment-name


# ──────────────────────────────────────────────────────────────
# Convex backend environment variables
#
# The values below are NOT read from this file. Set them on the
# deployment itself, either in the Convex dashboard or with:
#   npx convex env set RESEND_API_KEY re_xxxxxxxx
#
# Auth keys (JWKS, JWT_PRIVATE_KEY, SITE_URL) are provisioned
# automatically by `@convex-dev/auth` — see docs/SELF_HOSTING.md.
# ──────────────────────────────────────────────────────────────

# Optional. Enables real transactional email for payment requests,
# claims and verifications. Without it the backend runs in simulated
# mode and records every attempt to the `emailEvents` table instead.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional. Display name used in email subjects.
# APP_NAME=SplitSlip

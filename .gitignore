# ──────────────────────────────────────────────────────────────
# Secrets — never commit these
# ──────────────────────────────────────────────────────────────
.env
.env.*
.env.keys
!.env.example

# Signing material for Android release builds
*.jks
*.keystore
keystore.properties
android/keystore.properties
google-services.json
android/app/google-services.json

# ──────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ──────────────────────────────────────────────────────────────
# Build output
# ──────────────────────────────────────────────────────────────
dist
dist-ssr
build
*.local

# Convex codegen — regenerated by `npx convex dev`
src/convex/_generated

# Capacitor copies the built web app in here on `cap sync`
android/app/src/main/assets/public
ios/App/App/public

# ──────────────────────────────────────────────────────────────
# Android / Gradle build artifacts
# ──────────────────────────────────────────────────────────────
android/build
android/app/build
android/.gradle
android/local.properties
android/captures
android/.idea
android/app/release
android/app/debug
*.apk
*.aab
*.ap_
*.dex
.gradle
local.properties

# ──────────────────────────────────────────────────────────────
# Large downloadable assets
# tesseract.js fetches language data from its CDN at runtime, so the
# traineddata blob does not belong in version control.
# ──────────────────────────────────────────────────────────────
*.traineddata

# ──────────────────────────────────────────────────────────────
# Tooling caches
# ──────────────────────────────────────────────────────────────
.eslintcache
.cache
.temp
.tmp
*.tsbuildinfo
.vite
coverage
.nyc_output

# ──────────────────────────────────────────────────────────────
# Editors & OS
# ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────────────────────
# Sandbox / platform leftovers not part of the open-source app
# ──────────────────────────────────────────────────────────────
sst-env.d.ts
.sst
.github/modernize

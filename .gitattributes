# Normalise line endings so the repo is identical across platforms.
* text=auto eol=lf

# Keep shell scripts and the Gradle wrapper LF, always.
*.sh    text eol=lf
gradlew text eol=lf

# Windows-only files stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.apk  binary
*.aab  binary
*.jar  binary
*.keystore binary
*.jks  binary
*.traineddata binary

# Generated / vendored — collapse in PR diffs and exclude from language stats.
bun.lock          linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
src/components/ui/**  linguist-vendored=true
docs/screenshots/**   linguist-documentation=true
docs/brand/**         linguist-documentation=true
